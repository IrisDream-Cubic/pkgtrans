# Maintainer: Toru Momose <iris@iris-dream.top>
pkgname=pkgtrans
pkgver=1.0
pkgrel=1
pkgdesc="用 AI 翻译 pacman / yay / paru / pamac / flatpak 搜索结果的描述文字"
arch=('any')
url="https://github.com/IrisDream-Cubic/pkgtrans"
license=('MIT')
depends=('python')
optdepends=(
  'pacman: 翻译 pacman -Ss / -Si 的结果'
  'yay: 翻译 yay -Ss 的结果'
  'pamac: 翻译 pamac search / pamac info 的结果'
  'flatpak: 翻译 flatpak search 的结果'
)
provides=('pkgtrans')
backup=()
options=('!strip')
source=("$pkgname-$pkgver.tar.gz::$url/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz")
# 这里用 SKIP 是因为：tarball 由 `git archive` 从本仓库自身生成，把它的哈希写回
# 本文件会改变 commit、进而改变 tarball，形成循环。真实哈希请放在 AUR 的
# PKGBUILD 里（AUR 是独立仓库），或从 Release 页面的 sha256 复制。
# 本地构建时把 dist/pkgtrans-1.0.tar.gz 拷到本目录即可，makepkg 会直接用本地文件。
sha256sums=('SKIP')

package() {
  install -Dm755 "$srcdir/$pkgname-$pkgver/pkgtrans" "$pkgdir/usr/bin/pkgtrans"
  install -Dm644 "$srcdir/$pkgname-$pkgver/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 "$srcdir/$pkgname-$pkgver/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$srcdir/$pkgname-$pkgver/packaging/pkgtrans.bash-completion" \
    "$pkgdir/usr/share/bash-completion/completions/pkgtrans"
  install -Dm644 "$srcdir/$pkgname-$pkgver/packaging/_pkgtrans" \
    "$pkgdir/usr/share/zsh/site-functions/_pkgtrans"
}
