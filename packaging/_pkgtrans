#compdef pkgtrans
# zsh 补全：装到 /usr/share/zsh/site-functions/_pkgtrans
#
# 对外只有 help / info / menu 三个词；其余参数是「要包装的命令」，
# 交给 zsh 自己的命令补全。

_pkgtrans() {
  local -a subcmds
  subcmds=(
    'help:显示帮助'
    'menu:打开配置页（别名 ui / config）'
    'info:版本与开发者信息'
  )

  if (( CURRENT == 2 )); then
    _describe -t commands 'pkgtrans 子命令' subcmds
    return
  fi

  _normal
}

_pkgtrans "$@"
