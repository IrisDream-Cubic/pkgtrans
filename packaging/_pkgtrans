#compdef pkgtrans
# zsh 补全：装到 /usr/share/zsh/site-functions/_pkgtrans

_pkgtrans() {
  local -a subcmds
  subcmds=(
    'help:显示所有功能'
    'info:版本与开发者信息'
    'check:自检并真实调用一次 API'
    'aim:设置或查看目标语言'
    'keyadd:添加 API Key'
    'keylist:列出所有 API Key'
    'keyprefer:设置或查看优先 Key'
    'keyremove:删除某个 Key'
    'keylock:锁定为只使用优先 Key'
    'keyunlock:解锁，失败时自动切换备用'
    'setup:为包管理器启用翻译'
    'putes:取消某个包管理器的翻译'
    'install-winget:Windows 上自动安装 winget'
    'menu:交互式设置面板（包管理器 / 语言 / API Key）'
    'on:全局开启'
    'off:全局关闭'
    'clear-cache:清空翻译缓存'
    'show-config:显示最终生效的配置'
  )

  if (( CURRENT == 2 )); then
    _describe -t commands 'pkgtrans 子命令' subcmds
    return
  fi

  case $words[2] in
    aim)
      local -a langs
      langs=(default zh-hans zh-hant ja-jpan ko-kore eo-latn en-latn fr-latn de-latn ru-cyrl)
      _describe -t languages '目标语言' langs
      ;;
    setup|putes|putesy|unsetup)
      local -a managers
      managers=(all pacman yay paru pamac flatpak apt apt-cache dnf yum zypper brew winget)
      _describe -t managers '包管理器' managers
      ;;
    keyprefer|keyremove)
      local -a keys
      keys=(${(f)"$(pkgtrans keylist 2>/dev/null |
        sed -n 's/^ *[* ]*\([0-9][0-9]*\) -> \([^ ]*\).*/\1:\2/p')"})
      (( ${#keys} )) && _describe -t keys 'API Key 编号' keys
      ;;
    *)
      _normal
      ;;
  esac
}

_pkgtrans "$@"
