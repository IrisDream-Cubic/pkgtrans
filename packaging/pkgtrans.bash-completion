# bash 补全：装到 /usr/share/bash-completion/completions/pkgtrans
#
# 对外只有 help / info / menu 三个词；其余参数是「要包装的命令」，
# 交给 bash 自己的命令补全。

_pkgtrans_completions() {
  local cur
  cur="${COMP_WORDS[COMP_CWORD]}"

  if [ "$COMP_CWORD" -eq 1 ]; then
    COMPREPLY=( $(compgen -W "help info version menu ui config" -- "$cur") )
    return
  fi

  COMPREPLY=( $(compgen -c -- "$cur") )
}

complete -F _pkgtrans_completions pkgtrans
