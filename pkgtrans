SYSTEM_PROMPT = """\
你是一个软件包描述翻译器。用户会给你一个 JSON 字符串数组，每个元素是一条软件包描述（多为英文）。
请把每一条翻译成{lang}。

要求：
1. 严格保持数组长度和顺序一致，逐条对应。
2. 软件名、库名、命令名、协议名、缩写、公司名等专有名词保留英文原样，不要音译。
3. 译文要简洁自然，符合软件包管理器的描述风格；不要添加句号、引号等多余标点。
4. 不要添加任何解释、注释、编号或前后缀。
5. 如果某条本来就是{lang}，原样返回。
6. 如果某条无法翻译，原样返回。

只输出一个 JSON 字符串数组，例如：["译文一","译文二"]
不要输出 markdown 代码块，不要输出别的任何内容。"""


class ApiError(Exception):
    def __init__(self, message, status=None, retryable=False):
        super().__init__(message)
        self.status = status
        self.retryable = retryable


class TranslationFailed(Exception):
    """hard=True 表示这类错误重试多少次都没用（如 401/403），不要再二分试探。"""

    def __init__(self, message, hard=False):
        super().__init__(message)
        self.hard = hard


def _http_post_json(url, payload, headers, timeout):
    body = json.dumps(payload, ensure_ascii=False).encode("utf-8")
    req = urllib.request.Request(
        url,
        data=body,
        method="POST",
        headers={
            "Content-Type": "application/json",
            "Accept": "application/json",
            "User-Agent": f"{PROG}/{__version__}",
            **headers,
        },
    )
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            raw = resp.read().decode("utf-8", "replace")
    except urllib.error.HTTPError as exc:
        detail = ""
        try:
            detail = exc.read().decode("utf-8", "replace")[:400]
        except Exception:
            pass
        retryable = exc.code in (408, 409, 425, 429) or exc.code >= 500
        raise ApiError(f"HTTP {exc.code} {exc.reason} {detail}".strip(), exc.code, retryable)
    except urllib.error.URLError as exc:
        raise ApiError(f"网络错误：{exc.reason}", None, True)
    except TimeoutError:
        raise ApiError("请求超时", None, True)
    try:
        return json.loads(raw)
    except ValueError:
        raise ApiError(f"响应不是合法 JSON：{raw[:200]}")


def extract_json_array(text: str):
    """从模型回复里抠出 JSON（容忍 ``` 围栏和前后废话）。"""
    s = (text or "").strip()
    fence = re.search(r"```(?:json)?\s*(.*?)```", s, re.S)
    if fence:
        s = fence.group(1).strip()
    try:
        return json.loads(s)
    except ValueError:
        pass
    for opener, closer in (("[", "]"), ("{", "}")):
        start = s.find(opener)
        if start < 0:
            continue
        depth = 0
        in_str = False
        esc = False
        for i in range(start, len(s)):
            ch = s[i]
            if in_str:
                if esc:
                    esc = False
                elif ch == "\\":
                    esc = True
                elif ch == '"':
                    in_str = False
                continue
            if ch == '"':
                in_str = True
            elif ch == opener:
                depth += 1
            elif ch == closer:
                depth -= 1
                if depth == 0:
                    try:
                        return json.loads(s[start: i + 1])
                    except ValueError:
                        break
    raise ValueError("响应中找不到 JSON")


def normalize_items(parsed, expected: int):
    """把模型的返回统一成恰好 expected 个字符串（缺失记为 None）。"""
    items = parsed
    if isinstance(items, dict):
        for key in ("translations", "result", "results", "data", "items", "descriptions"):
            if isinstance(items.get(key), list):
                items = items[key]
                break
        else:
            for val in items.values():
                if isinstance(val, list):
                    items = val
                    break
    if isinstance(items, dict):
        # {"1": "译文", "2": "译文"} 这种
        try:
            items = [items[k] for k in sorted(items, key=lambda x: int(x))]
        except Exception:
            pass
    if not isinstance(items, list):
        raise ValueError("响应不是数组")

    out = []
    for item in items[:expected]:
        if isinstance(item, str):
            out.append(item.strip())
        elif isinstance(item, dict):
            for key in ("translation", "text", "zh", "译文", "content"):
                if isinstance(item.get(key), str):
                    out.append(item[key].strip())
                    break
            else:
                out.append(None)
        elif item is None:
            out.append(None)
        else:
            out.append(str(item).strip())
    out += [None] * (expected - len(out))
    return out


def call_openai(backend: Backend, batch, lang, extra, timeout):
    headers = {}
    if backend.key:
        headers["Authorization"] = "Bearer " + backend.key
    payload = {
        "model": backend.model,
        "temperature": 0,
        "messages": [
            {"role": "system", "content": SYSTEM_PROMPT.format(lang=lang)},
            {"role": "user", "content": json.dumps(batch, ensure_ascii=False)},
        ],
    }
    payload.update(extra)
    data = _http_post_json(backend.endpoint, payload, headers, timeout)
    try:
        content = data["choices"][0]["message"]["content"]
    except (KeyError, IndexError, TypeError):
        raise ApiError(f"响应结构异常：{json.dumps(data, ensure_ascii=False)[:200]}")
    if isinstance(content, list):   # 少数服务商返回分段内容
        content = "".join(part.get("text", "") for part in content if isinstance(part, dict))
    return content or ""


def call_anthropic(backend: Backend, batch, lang, extra, timeout):
    headers = {"anthropic-version": "2023-06-01"}
    if backend.key:
        headers["x-api-key"] = backend.key
    payload = {
        "model": backend.model,
        "max_tokens": 8192,
        "temperature": 0,
        "system": SYSTEM_PROMPT.format(lang=lang),
        "messages": [{"role": "user", "content": json.dumps(batch, ensure_ascii=False)}],
    }
    payload.update(extra)
    data = _http_post_json(backend.endpoint, payload, headers, timeout)
    blocks = data.get("content")
    if not isinstance(blocks, list):
        raise ApiError(f"响应结构异常：{json.dumps(data, ensure_ascii=False)[:200]}")
    return "".join(b.get("text", "") for b in blocks if isinstance(b, dict))


def extra_body(st) -> dict:
    raw = str(st["extra_body"] or "").strip()
    if not raw:
        return {}
    try:
        val = json.loads(raw)
        return val if isinstance(val, dict) else {}
    except ValueError:
        return {}


def request_translations(backend: Backend, batch, lang, extra, retries, timeout):
    last = None
    for attempt in range(retries + 1):
        try:
            if backend.style == "anthropic":
                raw = call_anthropic(backend, batch, lang, extra, timeout)
            else:
                raw = call_openai(backend, batch, lang, extra, timeout)
            return normalize_items(extract_json_array(raw), len(batch))
        except ApiError as exc:
            last = exc
            if not exc.retryable or attempt >= retries:
                break
            time.sleep(0.8 * (2 ** attempt))
        except ValueError as exc:
            last = exc
            break
    hard = isinstance(last, ApiError) and not last.retryable
    raise TranslationFailed(str(last), hard=hard)


