def _pick_provider_interactive():
    print("请选择服务商：")
    for i, (name, _style, _base, model) in enumerate(KEY_PROVIDERS, 1):
        print(f"  {i:>2}) {name:<12} {model}")
    print(f"   0) 其它（自己填地址和模型）")
    try:
        raw = input("选择 [1]: ").strip() or "1"
    except EOFError:
        raw = "1"
    if not raw.isdigit():
        return None
    n = int(raw)
    if n == 0:
        return ("自定义", "openai", "", "")
    if 1 <= n <= len(KEY_PROVIDERS):
        return KEY_PROVIDERS[n - 1]
    return None


def cmd_keyadd(st: Settings, args) -> int:
    opts, positional, i = {}, [], 0
    while i < len(args):
        arg = args[i]
        if arg.startswith("--"):
            name, _, inline = arg.partition("=")
            field = name[2:].replace("-", "_")
            if field not in ("provider", "base", "model", "style", "key"):
                fail(f"未知选项 {arg}")
                return 2
            if inline:
                opts[field] = inline
            else:
                i += 1
                if i >= len(args):
                    fail(f"{name} 需要一个参数")
                    return 2
                opts[field] = args[i]
        else:
            positional.append(arg)
        i += 1

    provider = opts.get("provider") or (positional[0] if positional else "")
    base = opts.get("base", "")
    model = opts.get("model", "")
    style = opts.get("style", "")
    key = opts.get("key") or (positional[1] if len(positional) > 1 else "")

    preset = None
    if not provider:
        if not sys.stdin.isatty():
            fail("非交互环境下请用：pkgtrans keyadd <服务商> <密钥> [模型]")
            note("或 pkgtrans keyadd --provider DeepSeek --key sk-xxx --model deepseek-chat")
            return 2
        preset = _pick_provider_interactive()
        if preset is None:
            fail("无效的选择")
            return 2
        provider, style, base, model = preset
    else:
        for item in KEY_PROVIDERS:
            if item[0].lower() == provider.lower():
                preset = item
                break
        if preset:
            provider, style, base, model = preset[0], style or preset[1], base or preset[2], \
                model or preset[3]

    if not key:
        if not sys.stdin.isatty():
            line = sys.stdin.readline().strip()
            if line:
                key = line
        if not key:
            try:
                import getpass
                key = getpass.getpass("API Key（输入不回显）: ").strip()
            except (EOFError, KeyboardInterrupt):
                fail("已取消")
                return 1
    if not key:
        fail("密钥不能为空")
        return 2

    if preset and not base:
        base = preset[2]
    if not base:
        try:
            base = input("API 地址（如 https://api.deepseek.com/v1）: ").strip()
        except EOFError:
            base = ""
    if not base:
        fail("API 地址不能为空")
        return 2
    if not model:
        default_model = preset[3] if preset else ""
        if sys.stdin.isatty():
            try:
                model = input(f"模型（回车用 {default_model or '默认'}）: ").strip()
            except EOFError:
                model = ""
        model = model or default_model
    if not style:
        style = preset[1] if preset else ("anthropic" if "anthropic" in base else "openai")

    keys, preferred, locked = load_keys(st.keys_path)
    backend = Backend(provider, style, base, model, key)
    if backend.needs_key() and not key:
        fail("该地址需要密钥")
        return 2
    entry = {"id": next_key_id(keys), "provider": provider, "style": backend.style,
             "base": backend.base, "model": model, "key": key}
    keys.append(entry)
    if preferred is None:
        preferred = entry["id"]
    save_keys(st.keys_path, keys, preferred, locked)
    ok(f"已添加 {provider} 密钥 {mask_key(key)}（编号 {entry['id']}）")
    return 0


def _find_key(keys, raw):
    if raw is None or not str(raw).strip():
        return None
    text = str(raw).strip()
    if text.isdigit():
        return next((k for k in keys if k.get("id") == int(text)), None)
    return next((k for k in keys if str(k.get("provider", "")).lower() == text.lower()), None)


def cmd_keyremove(st: Settings, args) -> int:
    keys, preferred, locked = load_keys(st.keys_path)
    if not keys:
        fail("密钥库是空的")
        return 1
    if not args:
        _print_keys(keys, preferred, locked)
        fail(f"请指定要删除的编号，如 `{PROG} keyremove 2`")
        return 2
    target = _find_key(keys, args[0])
    if target is None:
        fail(f"找不到编号 / 服务商：{args[0]}")
        return 2
    keys = [k for k in keys if k is not target]
    if preferred == target.get("id"):
        preferred = keys[0]["id"] if keys else None
    save_keys(st.keys_path, keys, preferred, locked)
    ok(f"已删除 [{target.get('id')}] {target.get('provider')} "
       f"{mask_key(target.get('key', ''))}")
    if not keys:
        warn("密钥库已空，将回落到配置文件 / 环境变量里的服务商")
    return 0


