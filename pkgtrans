CJK_RE = re.compile(r"[\u3040-\u30ff\u3400-\u4dbf\u4e00-\u9fff\uf900-\ufaff]")


def looks_chinese(text: str) -> bool:
    cjk = len(CJK_RE.findall(text))
    words = len(re.findall(r"[A-Za-z]{2,}", text))
    if cjk < 2:
        return False
    return words <= max(1, cjk // 4)


class Translator:
    def __init__(self, st: Settings, verbose=False):
        self.st = st
        self.verbose = verbose
        self.lang = st["target_lang"]
        self.extra = extra_body(st)
        self.retries = as_int(st["retries"], 2)
        self.backends = st.backends()
        self.bi = 0                      # 当前用第几个后端
        self.block = threading.Lock()
        first = self.backends[0] if self.backends else None
        # 缓存按「协议|地址|模型|目标语言」做键，与用哪个密钥无关
        self.engine = f"{first.cache_id() if first else 'none'}|{self.lang}"
        self.cache = Cache(st.cache_path, as_bool(st["cache"]))
        self.timeout = max(5, as_int(st["timeout"], 30))
        self.chunk = max(1, as_int(st["chunk_size"], 24))
        self.jobs = max(1, min(16, as_int(st["concurrency"], 4)))
        self.translated = 0
        self.failed = 0
        self.reused = 0
        self.skipped = 0
        self.requests = 0
        self.switches = 0
        self.error_streak = 0
        self.fatal = ""       # 所有后端都失败后熔断，避免把 token 烧在注定失败的请求上
        self.first_error = ""

    def current(self):
        if self.fatal:
            return None
        with self.block:
            return self.backends[self.bi] if self.bi < len(self.backends) else None

    def _advance(self):
        """切到下一个备用后端；没有更多则返回 False。"""
        with self.block:
            if self.bi + 1 >= len(self.backends):
                return False
            self.bi += 1
            self.switches += 1
            return True

    def run(self, texts):
        """texts: 待翻译文本列表。返回等长的 [译文 or None]。"""
        results = [None] * len(texts)
        pending = {}      # 文本 -> [下标...]
        for idx, text in enumerate(texts):
            if not text.strip():
                results[idx] = text
            elif as_bool(self.st["skip_cjk"]) and looks_chinese(text):
                results[idx] = text      # 无需翻译：原样当作译文，渲染为红色
                self.skipped += 1
            else:
                pending.setdefault(text, []).append(idx)

        # 缓存
        misses = []
        for text, idxs in pending.items():
            hit = self.cache.get(self.engine, text)
            if hit:
                for idx in idxs:
                    results[idx] = hit
                self.reused += len(idxs)
            else:
                misses.append(text)

        if misses:
            translated = self._translate_all(misses)
            for text, value in translated.items():
                for idx in pending[text]:
                    results[idx] = value

        # 统计
        for idx, text in enumerate(texts):
            if not text.strip():
                continue
            if results[idx]:
                self.translated += 1
            else:
                self.failed += 1
        self.cache.save()
        return results

    def _translate_all(self, misses) -> dict:
        chunks = [misses[i: i + self.chunk] for i in range(0, len(misses), self.chunk)]
        out = {}
        with cf.ThreadPoolExecutor(max_workers=self.jobs) as pool:
            futures = {pool.submit(self._translate_chunk, chunk): chunk for chunk in chunks}
            try:
                for fut in cf.as_completed(futures):
                    chunk = futures[fut]
                    try:
                        values = fut.result()
                    except Exception as exc:          # 兜底，正常不会走到
                        self._note_error(str(exc))
                        values = [None] * len(chunk)
                    for text, value in zip(chunk, values):
                        if value:
                            out[text] = value
                            self.cache.put(self.engine, text, value)
            except KeyboardInterrupt:
                for fut in futures:
                    fut.cancel()
                raise
        return out

    def _translate_chunk(self, chunk, depth=0):
        """整块失败就二分重试，直到单条；密钥不行就换下一个备用后端。

        单条仍失败则判为翻译失败（黄色）。所有后端都失败后熔断，
        否则一个写错的密钥会让工具发出上百个注定失败的请求。
        """
        if not chunk:
            return []
        backend = self.current()
        if backend is None:
            return [None] * len(chunk)

        problem = backend.problem()
        if problem:
            self._note_error(f"{backend.label()}：{problem}")
            if self._advance():
                return self._translate_chunk(chunk, depth + 1)
            return [None] * len(chunk)

        try:
            self.requests += 1
            values = request_translations(backend, chunk, self.lang, self.extra,
                                          self.retries, self.timeout)
            if len(chunk) > 1:
                missing = [i for i, v in enumerate(values) if not v]
                if len(missing) == len(chunk):
                    raise TranslationFailed("整块返回为空")
                if missing:      # 模型漏译了几条，只把这些单独补一次
                    sub = self._translate_chunk([chunk[i] for i in missing], depth + 1)
                    for i, val in zip(missing, sub):
                        values[i] = val
            self.error_streak = 0
            return values
        except Exception as exc:
            self._note_error(f"{backend.label()}：{exc}")
            hard = getattr(exc, "hard", False)
            self.error_streak += 1
            # 硬错误（401/403）或连续失败 -> 换下一个密钥再试
            if hard or self.error_streak >= 3:
                if self._advance():
                    self.error_streak = 0
                    if self.verbose:
                        eprint(f"{PROG}: → 改用备用密钥 {self.current().label()}")
                    return self._translate_chunk(chunk, depth + 1)
                if not self.fatal:
                    self.fatal = str(exc)
                return [None] * len(chunk)
            if len(chunk) == 1 or self.error_streak >= 4:
                if not self.fatal:
                    self.fatal = str(exc)
                return [None] * len(chunk)
            mid = len(chunk) // 2
            return (self._translate_chunk(chunk[:mid], depth + 1)
                    + self._translate_chunk(chunk[mid:], depth + 1))

    def _note_error(self, message):
        if not self.first_error:
            self.first_error = message
        if self.verbose:
            eprint(f"{PROG}: {message}")


