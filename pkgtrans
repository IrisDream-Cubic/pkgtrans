def parse_config_text(text: str) -> dict:
    out = {}
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#") or line.startswith(";"):
            continue
        if "=" not in line:
            continue
        key, _, val = line.partition("=")
        key = key.strip().lower()
        val = val.strip()
        # 去掉行尾注释（不在引号内）
        if val[:1] in ("'", '"'):
            quote = val[0]
            end = val.find(quote, 1)
            if end > 0:
                val = val[1:end]
        else:
            val = re.split(r"\s+#", val, maxsplit=1)[0].strip()
        out[key] = val
    return out


def key_for_base(base: str) -> str:
    """在环境变量里找与给定地址属于同一家服务商的密钥。

    避免「配置里写 DeepSeek 地址、环境里只有 OPENAI_API_KEY」时把别家的
    密钥发到错误的地址上去。
    """
    host = base.split("//", 1)[-1].split("/", 1)[0].lower()
    for env, pbase, _model, _style, _opt in PROVIDERS:
        phost = pbase.split("//", 1)[-1].split("/", 1)[0].lower()
        if host == phost and os.environ.get(env):
            return os.environ[env]
    return ""


def detect_provider() -> dict:
    """从环境变量里自动挑一个可用的服务商配置。"""
    if os.environ.get("OPENAI_BASE_URL"):
        return {
            "api_base": os.environ["OPENAI_BASE_URL"].rstrip("/"),
            "api_key": os.environ.get("OPENAI_API_KEY", ""),
            "model": os.environ.get("OPENAI_MODEL", "gpt-4o-mini"),
            "api_style": "openai",
        }
    for env, base, model, style, key_optional in PROVIDERS:
        val = os.environ.get(env)
        if env == "OLLAMA_HOST":
            if not val:
                continue
            val = val.strip()
            if not val.startswith("http"):
                val = "http://" + val
            return {
                "api_base": val.rstrip("/").removesuffix("/v1") + "/v1",
                "api_key": "ollama",
                "model": model,
                "api_style": style,
            }
        if val:
            return {"api_base": base, "api_key": val, "model": model, "api_style": style}
    return {}


class Backend:
    """一个可用的 API 端点：服务商 + 协议 + 地址 + 模型 + 密钥。"""

    __slots__ = ("provider", "style", "base", "model", "key", "key_id")

    def __init__(self, provider="", style="openai", base="", model="", key="", key_id=None):
        self.provider = provider or "自定义"
        self.style = "anthropic" if str(style).lower().startswith("anthropic") else "openai"
        self.base = (base or "").strip().rstrip("/")
        self.model = model or ""
        self.key = key or ""
        self.key_id = key_id

    @property
    def endpoint(self) -> str:
        if not self.base:
            return ""
        if self.style == "anthropic":
            return self.base if self.base.endswith("/messages") else self.base + "/v1/messages"
        if self.base.endswith("/chat/completions"):
            return self.base
        return self.base + "/chat/completions"

    def needs_key(self) -> bool:
        if not self.base:
            return False
        host = self.base.split("//", 1)[-1].split("/", 1)[0].split(":")[0].lower()
        return host not in ("localhost", "127.0.0.1", "::1", "0.0.0.0")

    def problem(self) -> str:
        """返回不能用的原因，能用则返回空串。"""
        if not self.base:
            return "未配置 API 地址"
        if self.needs_key() and not self.key:
            return "未配置 API 密钥"
        return ""

    def cache_id(self) -> str:
        return f"{self.style}|{self.base}|{self.model}"

    def label(self) -> str:
        base = self.provider
        if self.model and self.model not in base:
            base = f"{base}({self.model})"
        return base


def provider_name_for(base: str) -> str:
    host = (base or "").split("//", 1)[-1].split("/", 1)[0].lower()
    for name, _style, pbase, _model in KEY_PROVIDERS:
        if host == pbase.split("//", 1)[-1].split("/", 1)[0].lower():
            return name
    return host or "自定义"


def mask_key(key: str) -> str:
    """打码显示，保留前缀和末尾几位，方便分辨是哪一个。

    前缀取到第二个 `-` 之前，这样 `sk-`(DeepSeek) 与 `sk-ant-`(Claude) 能区分开。
    """
    key = key or ""
    if not key:
        return "(空)"
    if len(key) <= 10:
        return key[:2] + "*****" + key[-2:]
    prefix = key[:3]
    first = key.find("-")
    second = key.find("-", first + 1) if first >= 0 else -1
    if 0 <= first < second <= 8:
        prefix = key[: second + 1]
    return f"{prefix}*****{key[-6:]}"


def load_keys(path: str):
    """读取密钥库，返回 (keys, preferred_id, locked)。不存在或损坏都当空处理。"""
    try:
        with open(path, "r", encoding="utf-8") as fh:
            data = json.load(fh)
    except (OSError, ValueError):
        return [], None, False
    if not isinstance(data, dict):
        return [], None, False
    keys = [k for k in data.get("keys", []) if isinstance(k, dict) and k.get("key")]
    return keys, data.get("preferred"), bool(data.get("locked"))


def save_keys(path: str, keys, preferred, locked):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = f"{path}.tmp{os.getpid()}"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump({"version": 1, "preferred": preferred,
                   "locked": bool(locked), "keys": keys},
                  fh, ensure_ascii=False, indent=2)
    os.chmod(tmp, 0o600)
    os.replace(tmp, path)


def next_key_id(keys) -> int:
    return max((int(k.get("id", 0)) for k in keys), default=0) + 1


def resolve_language(text: str):
    """把 `zh-hant` 这类代码转成提示词里的语言名；未知的原样返回。"""
    raw = (text or "").strip()
    if not raw:
        return None
    return LANGUAGES.get(raw.lower(), raw)


def update_config_value(path: str, key: str, value: str) -> bool:
    """就地改写配置文件里的某一项（保留注释）。不存在则追加。返回是否写入成功。"""
    line = f"{key} = {value}"
    try:
        with open(path, "r", encoding="utf-8") as fh:
            text = fh.read()
    except FileNotFoundError:
        text = ""
    except OSError:
        return False
    pattern = re.compile(rf"^[ \t]*{re.escape(key)}[ \t]*=.*$", re.M)
    if pattern.search(text):
        text = pattern.sub(line, text, count=1)
    else:
        text = text.rstrip("\n") + f"\n\n# 由 `{PROG}` 子命令写入\n{line}\n"
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        tmp = f"{path}.tmp{os.getpid()}"
        with open(tmp, "w", encoding="utf-8") as fh:
            fh.write(text)
        os.replace(tmp, path)
        return True
    except OSError:
        return False


class Settings:
    def __init__(self):
        self.values = dict(DEFAULTS)
        self.sources = {}
        self.config_path = expand(DEFAULT_CONFIG_PATH)
        self.errors = []

    def set(self, key, value, source):
        self.values[key] = value
        self.sources[key] = source

    def __getitem__(self, key):
        return self.values.get(key, DEFAULTS.get(key, ""))

    def get(self, key, default=None):
        return self.values.get(key, default)

    @property
    def cache_path(self) -> str:
        return expand(self["cache_file"] or DEFAULT_CACHE_PATH)

    @property
    def keys_path(self) -> str:
        return expand(self["keys_file"] or DEFAULT_KEYS_PATH)

    @property
    def locked(self) -> bool:
        return bool(load_keys(self.keys_path)[2])

    def backends(self):
        """按优先级返回后端列表。

        优先级：显式环境变量 / 命令行  >  keys.json（keyadd 管理的密钥库）
                >  配置文件里的 api_base  >  自动探测

        也就是说：keys.json 一旦有内容，就不会被环境里那些「顺带存在」的
        DEEPSEEK_API_KEY 之类抢走；但显式写 PSTRANS_API_BASE / --api-key
        依然可以临时覆盖它（方便调试和一次性换后端）。
        """
        keys, preferred, locked = load_keys(self.keys_path)
        explicit = any(self.sources.get(k) in ("env", "cli")
                       for k in ("api_base", "api_key", "model"))
        if self["api_base"] and (explicit or not keys):
            return [Backend(provider_name_for(self["api_base"]), self["api_style"],
                            self["api_base"], self["model"], self["api_key"])]
        if keys:
            first = next((k for k in keys if k.get("id") == preferred), keys[0])
            ordered = [first] + ([] if locked else [k for k in keys if k is not first])
            return [Backend(k.get("provider"), k.get("style"), k.get("base"),
                            k.get("model"), k.get("key"), k.get("id")) for k in ordered]
        if self["api_base"]:
            return [Backend(provider_name_for(self["api_base"]), self["api_style"],
                            self["api_base"], self["model"], self["api_key"])]
        return []


def load_settings(cli: dict) -> Settings:
    st = Settings()

    # 1) 配置文件
    path = expand(cli.get("config") or os.environ.get("PSTRANS_CONFIG") or DEFAULT_CONFIG_PATH)
    st.config_path = path
    if os.path.exists(path):
        try:
            with open(path, "r", encoding="utf-8", errors="replace") as fh:
                for k, v in parse_config_text(fh.read()).items():
                    if k in DEFAULTS:
                        st.set(k, v, "config")
        except OSError as exc:
            st.errors.append(f"读取配置失败 {path}: {exc}")

    # 2) 环境变量
    for env, key in ENV_MAP.items():
        if env in os.environ:
            st.set(key, os.environ[env], "env")

    # 3) 自动探测
    #    - 没写 API 地址：整个服务商配置一起自动识别
    #    - 写了地址但没写密钥：只找同一家服务商的密钥，不跨家混用
    if not st["api_base"]:
        auto = detect_provider()
        for key, val in auto.items():
            if not st[key]:
                st.set(key, val, "auto")
    elif not st["api_key"]:
        matched = key_for_base(st["api_base"])
        if matched:
            st.set("api_key", matched, "auto")

    # 4) 命令行
    for key in ("api_base", "api_key", "model", "api_style", "target_lang"):
        if cli.get(key):
            st.set(key, cli[key], "cli")
    if cli.get("color") == "always":
        st.set("force_color", "1", "cli")
    elif cli.get("color") == "never":
        st.set("force_color", "-1", "cli")
    if cli.get("no_cache"):
        st.set("cache", "0", "cli")
    if cli.get("no_info"):
        st.set("translate_info", "0", "cli")
    if cli.get("bilingual"):
        st.set("bilingual", "1", "cli")
    if cli.get("chunk"):
        st.set("chunk_size", cli["chunk"], "cli")
    if cli.get("jobs"):
        st.set("concurrency", cli["jobs"], "cli")
    for opt in ("max_items", "timeout", "retries"):
        if cli.get(opt):
            st.set(opt, cli[opt], "cli")

    # 规范化
    style = str(st["api_style"]).strip().lower()
    st.set("api_style", "anthropic" if style.startswith("anthropic") else "openai", "normalize")
    st.set("api_base", str(st["api_base"]).strip().rstrip("/"), "normalize")
    if not st["model"]:
        st.set("model", "deepseek-chat" if "deepseek" in st["api_base"] else "gpt-4o-mini", "default")
    return st


def usable_backends(st: Settings):
    """能直接用的后端（地址、密钥都齐）。"""
    return [b for b in st.backends() if not b.problem()]


