def do_check(st: Settings, opts) -> int:
    keys, preferred, locked = load_keys(st.keys_path)
    print(f"{PROG} {__version__}   （{DEVELOPER} · {DEVELOPER_URL}）")
    print(f"配置文件      : {st.config_path}"
          f"{'' if os.path.exists(st.config_path) else '  (不存在)'}")
    print(f"密钥库        : {st.keys_path}"
          f"{'' if keys else '  (空，回落到配置文件/环境变量)'}"
          f"{'  [已锁定]' if locked else ''}")
    print(f"运行状态      : {'开启' if as_bool(st['enabled']) else '已关闭（pkgtrans on 恢复）'}")
    print(f"目标语言      : {st['target_lang']}")
    print(f"接管命令      : {', '.join(shell_targets(st)) or '(无)'}")
    print(f"后端链路      :")
    for backend in st.backends():
        mark = "→" if preferred and backend.key_id == preferred else " "
        problem = backend.problem()
        state = "就绪" if not problem else problem
        print(f"  {mark} [{backend.key_id if backend.key_id else '-'}] "
              f"{backend.label():<28} {mask_key(backend.key):<22} {state}")
        print(f"      {backend.endpoint or '(无地址)'}")
    print(f"  {'cache_file':<12}= {st.cache_path}")
    c_on, c_why = color_status(st)
    print(f"  {'颜色标记':<12}= {'开启' if c_on else '关闭'}（{c_why}）")
    rc_path = expand("~/.zshrc")
    try:
        with open(rc_path, "r", encoding="utf-8", errors="replace") as fh:
            rc_text = fh.read()
    except OSError:
        rc_text = ""
    if SHELL_BEGIN in rc_text:
        print(f"  {'shell 集成':<12}= 已写入 {rc_path}（终端里 `type pacman` 应显示 shell function）")
    else:
        print(f"  {'shell 集成':<12}= 未安装，跑 `{PROG} setup`；或手动用 `{PROG} <命令>`")

    usable = usable_backends(st)
    if not usable:
        print("\n结论：现在还不能翻译，描述会以黄色原样显示。")
        for line in api_setup_hints(st):
            print(line)
        return 1

    print("\n发起一次测试请求…")
    sample = ["A version manager for neovim", "Lightweight terminal file manager"]
    backend = usable[0]
    t0 = time.time()
    try:
        values = request_translations(backend, sample, st["target_lang"], extra_body(st),
                                      as_int(st["retries"], 2), max(5, as_int(st["timeout"], 30)))
    except Exception as exc:
        print(f"失败（{backend.label()}）：{exc}")
        return 1
    print(f"成功（{backend.label()}，{time.time() - t0:.2f}s）：")
    for src, dst in zip(sample, values):
        print(f"  {src}\n    -> {dst if dst else '(空)'}")
    return 0


