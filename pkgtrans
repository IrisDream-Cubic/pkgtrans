# shell 集成
# --------------------------------------------------------------------------

def installed_managers():
    return [m for m in KNOWN_MANAGERS if shutil.which(m)]


def shell_targets(st: Settings):
    """要接管的包管理器列表。

    配置为空 / auto = 自动（所有已安装的）；显式的 none = 一个都不接管。
    不然 `putes all` 会被当成「未配置」而自动变回全接管。
    """
    raw = str(st["shell_targets"] or "").strip()
    if not raw or raw == "auto":
        return installed_managers()
    if raw == "none":
        return []
    seen, out = set(), []
    for item in raw.replace(" ", ",").split(","):
        name = item.strip()
        if name and name not in seen:
            seen.add(name)
            out.append(name)
    return out


def shell_snippet(shell: str, targets) -> str:
    targets = list(targets)
    if shell == "powershell":
        return _powershell_snippet(targets)
    lines = [
        SHELL_BEGIN,
        "# 让这些命令的搜索结果自动经 AI 翻译：",
        f"#   {', '.join(targets) if targets else '(空，用 pkgtrans setup 添加)'}",
        "# 其他子命令（-Syu、install、run…）原样透传，行为完全不变。",
        f"# 由 `{PROG} setup` 写入，删除本段或用 `{PROG} putes` 即可卸载。",
        'if [ -x "$HOME/.local/bin/pkgtrans" ]; then',
    ]
    for name in targets:
        body = f'{name}() {{ command "$HOME/.local/bin/pkgtrans" {name} "$@"; }}'
        if shell == "bash":
            lines.append(f"  if command -v {name} >/dev/null 2>&1; then {body} fi")
        else:
            lines.append(f"  if (( $+commands[{name}] )); then {body} fi")
    lines += ["fi", SHELL_END]
    return "\n".join(lines) + "\n"


def _powershell_snippet(targets) -> str:
    """Windows 的写法：PowerShell 函数 + 显式 exe 路径（不能用 $HOME/.local/bin）。"""
    exe = program_path().replace("'", "''")     # PowerShell 单引号里 '' 是转义
    lines = [
        SHELL_BEGIN,
        "# 让这些命令的搜索结果自动经 AI 翻译：",
        f"#   {', '.join(targets) if targets else '(空，用 pkgtrans setup 添加)'}",
        "# 其他子命令（install、upgrade…）原样透传，行为完全不变。",
        f"# 由 `{PROG} setup` 写入，删除本段或用 `{PROG} putes` 即可卸载。",
    ]
    for name in targets:
        lines.append(f"function global:{name} {{ & '{exe}' {name} @args }}")
    lines.append(SHELL_END)
    return "\n".join(lines) + "\n"


def strip_block(text: str) -> str:
    pattern = re.compile(
        re.escape(SHELL_BEGIN) + r".*?" + re.escape(SHELL_END) + r"\n?",
        re.S,
    )
    return pattern.sub("", text)


def rc_path_for(shell: str) -> str:
    if shell == "powershell":
        return powershell_profile()
    return expand("~/.zshrc" if shell != "bash" else "~/.bashrc")


def powershell_profile() -> str:
    """PowerShell 的 $PROFILE 位置。

    PowerShell 7 和 Windows PowerShell 5.1 用的目录不一样，已存在的优先，
    都没有就按 7 的路径建（新装机器上基本是 7）。
    """
    home = os.path.expanduser("~")
    leaf = "Microsoft.PowerShell_profile.ps1"
    candidates = [
        os.path.join(home, "Documents", "PowerShell", leaf),
        os.path.join(home, "Documents", "WindowsPowerShell", leaf),
    ]
    for path in candidates:
        if os.path.exists(path):
            return path
    return candidates[0]


def program_path() -> str:
    """当前程序自己的可执行路径，写进 shell 片段里用。

    PyInstaller 打的 exe 里 sys.frozen 为真，sys.executable 就是 exe 本身；
    普通脚本取 argv[0] 的真实路径（可能是软链，realpath 一下）。
    """
    if getattr(sys, "frozen", False):
        return os.path.realpath(sys.executable)
    raw = sys.argv[0] or ""
    if raw and raw != "-" and os.path.exists(raw):
        return os.path.realpath(raw)
    found = shutil.which(PROG)
    if found:
        return os.path.realpath(found)
    here = globals().get("__file__")
    return os.path.realpath(here) if here else PROG


def terminal_name() -> str:
    """猜一下当前终端模拟器，只为了让提示语更具体；拿不准就返回空。

    注意终端模拟器和 shell 是两层：kitty/konsole 开窗口，zsh/bash 解释命令。
    这里返回的是窗口那层，用来告诉用户「新开一个 X 窗口」。

    只用「不会被继承下去」的强标记。像 KONSOLE_* 那组变量会从 KDE 会话
    泄露给不相关的进程（本机容器里就残留着 KONSOLE_VERSION），拿它判断会误报，
    所以宁可退回泛化的「新开一个终端窗口」。
    """
    env = os.environ
    if env.get("KITTY_WINDOW_ID"):
        return "kitty"
    if env.get("WEZTERM_PANE"):
        return "WezTerm"
    if env.get("ALACRITTY_WINDOW_ID") or env.get("ALACRITTY_LOG"):
        return "Alacritty"
    if env.get("WT_SESSION"):
        return "Windows Terminal"
    program = (env.get("TERM_PROGRAM") or "").strip()
    if program and len(program) <= 24 and not program.startswith("xterm"):
        return program
    return ""


def require_shell():
    """拿到可用的 shell 名；不支持时给出明确提示并返回 None。"""
    shell = guess_shell()
    if not shell:
        fail(f"不支持 $SHELL={os.environ.get('SHELL') or '(空)'}，目前只会写 "
             f"zsh / bash（Windows 上是 PowerShell）的配置")
        note(f"可以用 `{PROG} --shell-init zsh` 看片段，手动加到你的 shell 配置里")
        return None
    return shell


def install_shell(shell: str, targets, quiet=False):
    rc = rc_path_for(shell)
    old = ""
    if os.path.exists(rc):
        with open(rc, "r", encoding="utf-8", errors="replace") as fh:
            old = fh.read()
        backup = f"{rc}.pkgtrans.bak.{time.strftime('%Y%m%d%H%M%S')}"
        shutil.copy2(rc, backup)
        if not quiet:
            eprint(f"  已备份 {rc} -> {backup}")
    new = strip_block(old).rstrip("\n") + "\n\n" + shell_snippet(shell, targets).rstrip("\n") + "\n"
    if new.startswith("\n\n"):
        new = new.lstrip("\n")
    try:
        os.makedirs(os.path.dirname(rc), exist_ok=True)
        with open(rc, "w", encoding="utf-8") as fh:
            fh.write(new)
    except OSError as exc:
        fail(f"写入 {rc} 失败：{exc}")
        return False
    return True


def uninstall_shell(shell: str, quiet=False):
    rc = rc_path_for(shell)
    if not os.path.exists(rc):
        eprint(f"  ! {rc} 不存在")
        return 1
    with open(rc, "r", encoding="utf-8", errors="replace") as fh:
        old = fh.read()
    if SHELL_BEGIN not in old:
        if not quiet:
            eprint(f"  ! {rc} 中没有 pkgtrans 集成")
        return 0
    backup = f"{rc}.pkgtrans.bak.{time.strftime('%Y%m%d%H%M%S')}"
    shutil.copy2(rc, backup)
    try:
        with open(rc, "w", encoding="utf-8") as fh:
            fh.write(strip_block(old))
    except OSError as exc:
        eprint(f"  ✗ 写入 {rc} 失败：{exc}")
        return 1
    if not quiet:
        eprint(f"  已从 {rc} 移除（备份：{backup}）")
    return 0


def guess_shell() -> str:
    """判断该往哪个 rc 文件写。

    Windows 走 PowerShell 的 $PROFILE（没有 .zshrc 这回事）。
    其它系统先看 $SHELL；它没设、或指向 zsh/bash 之外的 shell 时，退回
    /etc/passwd 里登记的**登录 shell**——CI runner 和容器里 $SHELL 经常是
    /bin/sh，只看它会把环境误判成「不支持」而拒绝写配置。
    两个来源都不是 zsh/bash 才真的返回空。
    """
    if os.name == "nt":
        return "powershell"
    candidates = [os.environ.get("SHELL", "")]
    try:
        import pwd
        candidates.append(pwd.getpwuid(os.getuid()).pw_shell or "")
    except (ImportError, KeyError, OSError):
        pass
    for path in candidates:
        name = os.path.basename(path or "")
        if "zsh" in name:
            return "zsh"
        if "bash" in name:
            return "bash"
    return ""


