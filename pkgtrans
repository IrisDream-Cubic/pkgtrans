class UsageError(Exception):
    pass


def parse_args(argv):
    """返回 (cli, command, cmdargs)。选项必须写在命令之前。"""
    cli = {}
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg == "--":
            i += 1
            if i < len(argv):
                return cli, argv[i], argv[i + 1:]
            return cli, None, []
        if arg.startswith("-") and arg != "-":
            name, _, inline = arg.partition("=")
            if name not in KNOWN_OPTS:
                raise UsageError(f"未知选项：{arg}")
            key, takes_value = KNOWN_OPTS[name]
            if takes_value:
                if inline:
                    cli[key] = inline
                else:
                    i += 1
                    if i >= len(argv):
                        raise UsageError(f"{name} 需要一个参数")
                    cli[key] = argv[i]
            else:
                cli[key] = True
            i += 1
            continue
        return cli, arg, argv[i + 1:]
    return cli, None, []


