# --------------------------------------------------------------------------
# 输出解析
# --------------------------------------------------------------------------

ANSI_RE = re.compile(r"\x1b\[[0-9;?]*[ -/]*[@-~]")

REPO = r"[A-Za-z0-9][A-Za-z0-9@._+-]*"
PNAME = r"[A-Za-z0-9@._+][A-Za-z0-9@._+:-]*"
# 形如 `extra/neovim 0.12.5-1` 或 `aur/foo 1.0-1 (+3 0.12) [2d] `
HEADER_RE = re.compile(rf"^(?P<repo>{REPO})/(?P<name>{PNAME})\s+\S")
# 形如 `Description     : Fork of Vim ...`（兼容中文字段名）
INFO_RE = re.compile(r"^(?P<label>[^:\s][^:]*?)\s*:\s*(?P<value>\S.*)$")
INFO_LABELS = {"description", "summary", "描述", "简介", "摘要"}

KIND_OTHER = "other"
KIND_DESC = "desc"
KIND_INFO = "info"

# pamac search 每行末尾右对齐的仓库名
PAMAC_REPOS = {"aur", "core", "extra", "multilib", "community", "testing",
               "staging", "unstable", "local", "installed", "chaotic-aur",
               "endeavouros", "cachyos", "rebornos"}
# flatpak search 默认列顺序（--columns 可改）
FLATPAK_DEFAULT_COLUMNS = ["name", "description", "application",
                           "version", "branch", "remotes"]

VERSIONISH_RE = re.compile(r"^[0-9rv]")


def display_width(s: str) -> int:
    """终端显示宽度：中日韩全角字符算 2 列。"""
    return sum(2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1 for ch in s)


def wrap_display(text: str, width: int):
    """按显示宽度折行（width <= 0 表示不折）。英文尽量不切断单词。"""
    if width <= 0 or display_width(text) <= width:
        return [text]
    lines, rest = [], text
    while rest:
        if display_width(rest) <= width:
            lines.append(rest.rstrip())
            break
        used, cut = 0, 1
        for i, ch in enumerate(rest):
            w = 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1
            if used + w > width:
                break
            used += w
            cut = i + 1
        piece = rest[:cut]
        if " " in piece.rstrip() and not piece.endswith(" "):
            sp = piece.rstrip().rfind(" ")
            if sp >= len(piece) // 2:
                piece, cut = piece[:sp], sp
        lines.append(piece.rstrip())
        rest = rest[cut:].lstrip()
    return lines or [text]


class Segment:
    __slots__ = ("prefix", "text", "kind", "tkey", "suffix", "wrap_width",
                 "raw_lines", "cont_prefix")

    def __init__(self, prefix, text, kind, tkey=None,
                 suffix="", wrap_width=0, raw_lines=None, cont_prefix=None):
        self.prefix = prefix          # 缩进 / `Description   : ` 等前缀，原样保留
        self.text = text              # 待翻译的文本（折行的已合并成一行）
        self.kind = kind
        self.tkey = tkey
        self.suffix = suffix          # flatpak TSV 里描述列后面的制表符列
        self.wrap_width = wrap_width  # >0 时把译文按此显示宽度折回多行
        self.raw_lines = raw_lines    # 原文的原始分行，用于失败时逐字还原
        # 折行后续行用的前缀：pamac info 要缩进到值那一列，而不是重复字段名
        self.cont_prefix = prefix if cont_prefix is None else cont_prefix

    def cont(self) -> str:
        return self.cont_prefix


def _is_pamac_header(plain: str) -> bool:
    """pamac search 的包头：`名字  版本 …<右对齐>仓库`，不是 `repo/name` 形式。

    要排除 `Repository      : extra` 这类「字段 : 值」行——它的最后一个词
    可能正好是个仓库名（extra / core / updates），会被误当成包头。
    判据是第二个词恰好是单独的冒号；pamac 的版本号里即使有冒号（epoch，
    如 `1:1.0.11-1`）也是粘在数字里的，不会被 split 成独立的 `:`。
    """
    if plain[:1].isspace():
        return False
    toks = plain.split()
    if len(toks) < 3 or toks[1] == ":" or "/" in toks[0]:
        return False
    return toks[-1].lower() in PAMAC_REPOS or bool(VERSIONISH_RE.match(toks[1]))


def _pamac_info_field(lines, i):
    """匹配 `Description : 值` 并把缩进对齐的折行续行合并进来。"""
    plain = ANSI_RE.sub("", lines[i])
    m = INFO_RE.match(plain)
    if not m or m.group("label").strip().lower() not in INFO_LABELS:
        return None
    parts = [m.group("value")]
    cont_indent = None
    k = i + 1
    while k < len(lines):
        nxt = ANSI_RE.sub("", lines[k])
        if nxt.strip() and nxt[:1].isspace():
            if cont_indent is None:
                cont_indent = nxt[: len(nxt) - len(nxt.lstrip())]
            parts.append(nxt.strip())
            k += 1
        else:
            break
    width = max(display_width(p) for p in parts) if len(parts) > 1 else 0
    prefix = plain[: m.start("value")]
    # 续行缩进沿用原文的，这样翻译失败时逐字还原出来和原样一模一样
    # （dnf info 的续行是 15 空格 + `: `，并不等于前缀宽度 17）。
    if cont_indent is None:
        cont_indent = " " * display_width(prefix)
    # 合并成一句时，去掉续行开头重复的冒号：dnf info / rpm 会在续行再写一个
    # `: `（纯为对齐），留着的话模型会看到夹在句子中间的冒号，影响译文。
    # raw_lines 仍保留原样，失败回退时逐字还原。
    joined = " ".join(re.sub(r"^:\s*", "", p) for p in parts)
    return Segment(prefix, joined, KIND_INFO, wrap_width=width,
                   raw_lines=parts, cont_prefix=cont_indent), k


def analyze_pacman(text: str, translate_info: bool):
    """pacman / yay / paru 的 `-Ss` / `-Si` 输出。"""
    segments = []
    lines = text.split("\n")
    expect_desc = False
    for line in lines:
        plain = ANSI_RE.sub("", line)
        stripped = plain.strip()

        if not stripped:
            segments.append(Segment("", line, KIND_OTHER))
            expect_desc = False
            continue

        # 缩进行：紧跟在包头行之后 -> 描述
        if plain[:1].isspace():
            indent = plain[: len(plain) - len(plain.lstrip())]
            if expect_desc:
                segments.append(Segment(indent, stripped, KIND_DESC))
                continue
            # 包信息块里的 Description 字段（少数情况会带缩进）
            if translate_info:
                m = INFO_RE.match(stripped)
                if m and m.group("label").strip().lower() in INFO_LABELS:
                    segments.append(
                        Segment(indent + stripped[: m.start("value")], m.group("value"), KIND_INFO)
                    )
                    continue
            segments.append(Segment("", line, KIND_OTHER))
            continue

        # 非缩进的 `Description : ...`（pacman -Si 实际输出即如此）
        if translate_info:
            m = INFO_RE.match(plain)
            if m and m.group("label").strip().lower() in INFO_LABELS:
                segments.append(Segment(plain[: m.start("value")], m.group("value"), KIND_INFO))
                expect_desc = False
                continue

        if HEADER_RE.match(plain):
            expect_desc = True
        else:
            expect_desc = False
        segments.append(Segment("", line, KIND_OTHER))
    return segments


def analyze_pamac(text: str, translate_info: bool):
    """pamac search / pamac info 输出。描述会折行，需要合并后再翻译、译完折回。"""
    segments = []
    lines = text.split("\n")
    i = 0
    while i < len(lines):
        line = lines[i]
        plain = ANSI_RE.sub("", line)

        if not plain.strip():
            segments.append(Segment("", line, KIND_OTHER))
            i += 1
            continue

        # 1) pamac info 的 Description 字段（值也折行）
        if translate_info and not plain[:1].isspace():
            got = _pamac_info_field(lines, i)
            if got:
                seg, i = got
                segments.append(seg)
                continue

        # 2) pamac search 的包头行 + 紧随其后的折行描述
        if _is_pamac_header(plain):
            segments.append(Segment("", line, KIND_OTHER))
            block, k = [], i + 1
            while k < len(lines):
                p = ANSI_RE.sub("", lines[k])
                if p.strip() and p[:1].isspace():
                    block.append(p)
                    k += 1
                else:
                    break
            if block:
                indent = block[0][: len(block[0]) - len(block[0].lstrip())]
                segments.append(Segment(indent, " ".join(b.strip() for b in block),
                                        KIND_DESC,
                                        wrap_width=max(display_width(b.strip()) for b in block),
                                        raw_lines=[b.strip() for b in block]))
            i = k
            continue

        segments.append(Segment("", line, KIND_OTHER))
        i += 1
    return segments


def analyze_flatpak(text: str, columns=None):
    """flatpak search 的 TSV 输出：描述是其中一列。"""
    cols = [c.split(":", 1)[0].strip().lower() for c in (columns or FLATPAK_DEFAULT_COLUMNS)]
    try:
        idx = cols.index("description")
    except ValueError:
        idx = 1
    segments = []
    for line in text.split("\n"):
        fields = line.split("\t")
        if not line.strip() or "\t" not in line or len(fields) <= idx or not fields[idx].strip():
            segments.append(Segment("", line, KIND_OTHER))
            continue
        prefix = "\t".join(fields[:idx]) + "\t" if idx else ""
        suffix = "\t" + "\t".join(fields[idx + 1:]) if idx + 1 < len(fields) else ""
        segments.append(Segment(prefix, fields[idx], KIND_DESC, suffix=suffix))
    return segments


PAMAC_SUBCOMMANDS = {"search", "info"}

# dnf / yum search：` name.arch<TAB>描述`。架构名不含点，所以从最后一个点断开，
# 对 python3.11-foo.x86_64 这种名字里带点的包也成立。
DNF_LINE_RE = re.compile(r"^(?P<pre>\s*[^\t]+?\.[^.\s\t]+)\t(?P<desc>.+)$")
# apt-cache search：单行 `名字 - 描述`
APTCACHE_LINE_RE = re.compile(r"^(?P<name>\S+)\s+-\s+(?P<desc>.+)$")


def analyze_dnf(text: str):
    """dnf / yum search 的输出。

    形如 ``  neovim.x86_64<TAB>Vim-fork focused on extensibility and agility``。
    ``Matched fields: name (exact)`` 这类元信息行原样放过。
    """
    segments = []
    for line in text.split("\n"):
        m = DNF_LINE_RE.match(ANSI_RE.sub("", line))
        if m:
            segments.append(Segment(m.group("pre") + "\t", m.group("desc").strip(), KIND_DESC))
        else:
            segments.append(Segment("", line, KIND_OTHER))
    return segments


def analyze_aptcache(text: str):
    """apt-cache search 的单行输出：``名字 - 描述``。"""
    segments = []
    for line in text.split("\n"):
        m = APTCACHE_LINE_RE.match(ANSI_RE.sub("", line))
        if m:
            segments.append(Segment(m.group("name") + " - ", m.group("desc").strip(), KIND_DESC))
        else:
            segments.append(Segment("", line, KIND_OTHER))
    return segments


# brew info 的包头：`==> 名字: 版本 …`
BREW_INFO_HEADER_RE = re.compile(r"^==> (?P<name>[^:]+): \S")
# brew search --desc 的一行：`名字: 描述`
BREW_DESC_RE = re.compile(r"^(?P<name>[A-Za-z0-9@._+-]+): (?P<desc>\S.*)$")
BREW_SECTION_RE = re.compile(r"^==>\s+(Formulae|Casks)\s*$")


def analyze_brew(text: str):
    """Homebrew 的两种输出。

    ``brew info``：描述是紧跟在 ``==> 名字: 版本 …`` **后面那一行**，没有字段名。
    ``brew search --desc``：每行 ``名字: 描述``，分 Formulae / Casks 两段。
    不带 --desc 的 ``brew search`` 只列包名，没有可翻的东西。

    注意 ``Aliases: nvim`` / ``License: Apache-2.0`` 也是 ``名字: 值`` 的形状，
    所以 ``名字: 描述`` 这条规则只在 Formulae / Casks 段里生效。
    """
    segments = []
    expect_desc = False
    in_search = False
    for line in text.split("\n"):
        plain = ANSI_RE.sub("", line)
        if BREW_SECTION_RE.match(plain):
            in_search, expect_desc = True, False
            segments.append(Segment("", line, KIND_OTHER))
            continue
        if plain.startswith("==>"):
            in_search = False
            expect_desc = bool(BREW_INFO_HEADER_RE.match(plain))
            segments.append(Segment("", line, KIND_OTHER))
            continue
        if expect_desc:
            expect_desc = False
            if plain.strip():
                segments.append(Segment("", line, KIND_DESC))
                continue
        if in_search:
            m = BREW_DESC_RE.match(plain)
            if m:
                segments.append(Segment(m.group("name") + ": ", m.group("desc"), KIND_DESC))
                continue
        segments.append(Segment("", line, KIND_OTHER))
    return segments


def detect_dialect(text: str) -> str:
    """管道模式下猜测输出是哪家的。"""
    lines = text.split("\n")[:300]
    for line in lines:
        if line.count("\t") >= 3:
            return "flatpak"
    # dnf / yum：带前导空格的 `名字.架构<TAB>描述`
    for line in lines:
        if DNF_LINE_RE.match(ANSI_RE.sub("", line)):
            return "dnf"
    # Homebrew：`==> Formulae` / `==> Casks` 段头，或 `==> 名字: 版本`
    for line in lines:
        plain = ANSI_RE.sub("", line)
        if BREW_SECTION_RE.match(plain) or BREW_INFO_HEADER_RE.match(plain):
            return "brew"
    for line in lines:
        plain = ANSI_RE.sub("", line).rstrip()
        if plain and not plain[:1].isspace():
            toks = plain.split()
            # toks[1] == ":" 用来排除 `Repository      : extra` 这类字段行
            if len(toks) >= 3 and toks[1] != ":" and "/" not in toks[0] \
                    and toks[-1].lower() in PAMAC_REPOS:
                return "pamac"
    # apt-cache：绝大多数非空行都是 `名字 - 描述`
    body = [ANSI_RE.sub("", l) for l in lines if ANSI_RE.sub("", l).strip()]
    if len(body) >= 3 and sum(1 for l in body if APTCACHE_LINE_RE.match(l)) >= len(body) * 0.9:
        return "apt-cache"
    # 信息类输出（pacman -Si、pamac info、apt show、dnf info）：几乎全是
    # `字段 : 值` 行加缩进续行。必须认出来，否则会落到 pacman 方言，
    # 而那个解析器不合并续行，Description 就只有第一行被翻译。
    if len(body) >= 3:
        shaped = sum(1 for l in body if l[:1].isspace() or INFO_RE.match(l))
        if shaped >= len(body) * 0.8:
            return "info"
    return "pacman"


def analyze(text: str, translate_info: bool, dialect: str = "pacman", columns=None):
    """把输出切成段落，标出哪些行是需要翻译的描述。"""
    if dialect == "flatpak":
        return analyze_flatpak(text, columns)
    if dialect in ("pamac", "info", "apt-info", "dnf-info"):
        # pamac 那个解析器能处理「字段: 值 + 缩进续行」，apt show / dnf info 同构
        return analyze_pamac(text, translate_info)
    if dialect == "dnf":
        return analyze_dnf(text)
    if dialect == "apt-cache":
        return analyze_aptcache(text)
    if dialect == "brew":
        return analyze_brew(text)
    # pacman 与 `apt search` 结构相同：`名字/仓库 版本 架构` + 缩进描述
    return analyze_pacman(text, translate_info)


