def as_bool(value) -> bool:
    if isinstance(value, bool):
        return value
    return str(value).strip().lower() in ("1", "true", "yes", "on", "y", "是")


def as_int(value, fallback: int) -> int:
    try:
        return int(str(value).strip())
    except Exception:
        return fallback


