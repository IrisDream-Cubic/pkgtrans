def _pad(text, width):
    """按显示宽度补空格（中文算 2 列）。"""
    return text + " " * max(0, width - display_width(text))


def _print_manager_table(st: Settings):
    active = set(shell_targets(st))
    shown = visible_managers()
    plat = current_platform()
    print(f"  {_pad('包管理器', 12)}{_pad('已安装', 8)}{_pad('已接管', 8)}")
    for name in shown:
        installed = shutil.which(name) is not None
        print(f"  {_pad(name, 12)}{_pad('✓' if installed else '-', 8)}"
              f"{'✓' if name in active else '-'}")
    note(f"当前系统：{PLATFORM_LABELS.get(plat, plat)}")
    hidden = [m for m in KNOWN_MANAGERS if m not in shown]
    if hidden:
        note(f"其它平台的命令不列出：{', '.join(hidden)}")
    note(f"`{PROG} setup <名字…>` 接管 / `{PROG} putes <名字…>` 取消（all = 全部）")
    note(f"接管项改动需 {_restart_hint()}；语言 / 密钥 / 开关是立即生效的")


def _restart_hint() -> str:
    """「怎么让新的 shell 集成生效」的一句话，把窗口和 shell 两层的名字都点出来。"""
    shell = guess_shell() or "zsh"
    term = terminal_name()
    if shell == "powershell":
        where = f"新开一个 {term} 窗口" if term else "新开一个 PowerShell 窗口"
        return where
    where = f"新开一个 {term} 窗口" if term else "新开一个终端窗口"
    return f"{where}或 `exec {shell}` 后生效"


def _write_targets(st: Settings, targets) -> bool:
    # 先落 shell 配置，成功了再写状态，避免失败时留下半改的状态
    shell = guess_shell()
    if not shell:
        fail(f"不支持 $SHELL={os.environ.get('SHELL')}，只支持 zsh / bash / PowerShell")
        note("可以手动加一行：function pacman { pkgtrans pacman $argv; }（fish 语法示例）")
        return False
    value = ",".join(targets) if targets else "none"
    if not install_shell(shell, targets, quiet=True):
        return False
    if not update_config_value(st.config_path, "shell_targets", value):
        fail(f"写入配置失败：{st.config_path}")
        return False
    st.set("shell_targets", value, "cli")
    ok(f"已接管：{', '.join(targets) or '无'}")
    note(_restart_hint())
    return True


def _resolve_manager_args(args):
    names = []
    for a in args:
        for part in a.replace(" ", ",").split(","):
            part = part.strip()
            if part and part not in names:
                names.append(part)
    if "all" in names:
        return installed_managers()
    return names


def cmd_setup(st: Settings, args) -> int:
    if not args:
        _print_manager_table(st)
        return 0
    names = _resolve_manager_args(args)
    unknown = [n for n in names if n not in MANAGER_META]
    if unknown:
        warn(f"不在已知列表里，仍会照写：{', '.join(unknown)}")
    # 平台不对的命令拒绝接管：在 Debian 上写一个 yay() 函数，只会得到一个
    # 永远找不到可执行文件的死包装，比直接报错更让人困惑。
    shown = set(visible_managers())
    stranger = [n for n in names if n in MANAGER_META and n not in shown]
    if stranger:
        plat = current_platform()
        for name in stranger:
            owner = MANAGER_META[name][0]
            fail(f"{name} 属于 {PLATFORM_LABELS.get(owner, owner)}，"
                 f"当前系统是 {PLATFORM_LABELS.get(plat, plat)}")
        note(f"本平台可用：{', '.join(platform_managers())}")
        note("确实装了别家的包管理器？装好之后它就会自动出现在列表里")
        return 1
    current = shell_targets(st)
    added = [n for n in names if n not in current]
    if not added:
        warn("本来就已接管")
        return 0
    if not _write_targets(st, current + added):
        return 1
    missing = [n for n in added if not shutil.which(n)]
    if missing:
        warn(f"{', '.join(missing)} 没有安装，装上后自动生效")
    return 0


def cmd_putes(st: Settings, args) -> int:
    if not args:
        _print_manager_table(st)
        return 0
    names = _resolve_manager_args(args)
    if "all" in args:
        names = shell_targets(st)
    current = shell_targets(st)
    removed = [n for n in names if n in current]
    if not removed:
        warn("本来就没接管")
        return 0
    return 0 if _write_targets(st, [n for n in current if n not in removed]) else 1


