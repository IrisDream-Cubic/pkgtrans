def colorize(text, code, enabled):
    if not enabled or not code or str(code) == "0":
        return text
    return f"{ESC}{code}m{text}{RESET}"


def render(segments, results, st, color_enabled, max_items):
    """按段渲染最终输出。results 与 segments 里可翻译的段等长。"""
    limit = float("inf") if max_items <= 0 else max_items
    c_ok = st["color_ok"]
    c_fail = st["color_fail"]
    c_dim = st["color_dim"]
    bilingual = as_bool(st["bilingual"])
    out = []
    index = 0
    for seg in segments:
        if seg.kind == KIND_OTHER:
            out.append(seg.text)
            continue
        if index >= limit:                       # 超出上限：不改动
            for raw in (seg.raw_lines or [seg.text]):
                out.append(seg.prefix + raw + seg.suffix)
            index += 1
            continue
        value = results[index]
        index += 1
        if value:
            lines = wrap_display(value, seg.wrap_width)
            first = colorize(lines[0], c_ok, color_enabled)
            if bilingual and value.strip() != seg.text.strip():
                first += colorize(f"  ({seg.text})", c_dim, color_enabled)
            out.append(seg.prefix + first + seg.suffix)
            for extra in lines[1:]:
                out.append(seg.cont() + colorize(extra, c_ok, color_enabled))
        else:
            # 失败：按原文原始分行逐行还原，避免重新折行导致漂移
            raw = seg.raw_lines or wrap_display(seg.text, seg.wrap_width)
            out.append(seg.prefix + colorize(raw[0], c_fail, color_enabled) + seg.suffix)
            for extra in raw[1:]:
                out.append(seg.cont() + colorize(extra, c_fail, color_enabled))
    return "\n".join(out)


