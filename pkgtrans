class Cache:
    MAX_ENTRIES = 20000

    def __init__(self, path: str, enabled: bool):
        self.path = path
        self.enabled = enabled
        self.entries = {}
        self.dirty = False
        self.hits = 0
        if enabled:
            self._load()

    def _load(self):
        try:
            with open(self.path, "r", encoding="utf-8") as fh:
                data = json.load(fh)
            if isinstance(data, dict) and isinstance(data.get("entries"), dict):
                self.entries = data["entries"]
        except FileNotFoundError:
            pass
        except Exception:
            self.entries = {}   # 缓存坏了就重建，不影响使用

    def _key(self, engine: str, src: str) -> str:
        return hashlib.sha256(f"{engine}\x00{src}".encode("utf-8")).hexdigest()

    def get(self, engine: str, src: str):
        if not self.enabled:
            return None
        item = self.entries.get(self._key(engine, src))
        if not item:
            return None
        self.hits += 1
        item["u"] = int(time.time())
        self.dirty = True
        return item.get("t")

    def put(self, engine: str, src: str, dst: str):
        if not self.enabled:
            return
        self.entries[self._key(engine, src)] = {"t": dst, "u": int(time.time())}
        self.dirty = True

    def save(self):
        if not self.enabled or not self.dirty:
            return
        if len(self.entries) > self.MAX_ENTRIES:
            keep = sorted(self.entries.items(), key=lambda kv: kv[1].get("u", 0), reverse=True)
            self.entries = dict(keep[: self.MAX_ENTRIES])
        try:
            os.makedirs(os.path.dirname(self.path), exist_ok=True)
            tmp = self.path + f".tmp{os.getpid()}"
            with open(tmp, "w", encoding="utf-8") as fh:
                json.dump({"version": 1, "entries": self.entries}, fh, ensure_ascii=False)
            os.replace(tmp, self.path)
        except OSError:
            pass


