def current_platform() -> str:
    """当前系统属于哪一支：arch / debian / fedora / suse / macos / windows / linux。

    只用来决定「哪些包管理器值得显示和接管」，判断错了也只影响展示，
    所以用 /etc/os-release 的 ID + ID_LIKE 就够，不引第三方库。
    可用 PSTRANS_PLATFORM 覆盖（比如 WSL 里想按 arch 看，或者在 CI 里
    让行为与跑测试的机器无关）。
    """
    forced = os.environ.get("PSTRANS_PLATFORM", "").strip().lower()
    if forced in PLATFORM_LABELS:
        return forced
    if _PLATFORM_CACHE:
        return _PLATFORM_CACHE[0]
    if os.name == "nt":
        plat = "windows"
    elif sys.platform == "darwin":
        plat = "macos"
    else:
        info = {}
        try:
            with open("/etc/os-release", encoding="utf-8") as fh:
                for line in fh:
                    if "=" in line:
                        key, value = line.rstrip("\n").split("=", 1)
                        info[key] = value.strip().strip('"').lower()
        except OSError:
            pass
        ids = {info.get("ID", "")} | set(info.get("ID_LIKE", "").split())
        ids.discard("")
        if ids & {"arch", "manjaro", "endeavouros", "garuda", "cachyos", "artix"}:
            plat = "arch"
        elif ids & {"debian", "ubuntu", "linuxmint", "pop", "kali",
                    "raspbian", "elementary", "zorin", "deepin"}:
            plat = "debian"
        elif ids & {"fedora", "rhel", "centos", "rocky", "almalinux",
                    "ol", "amzn", "nobara"}:
            plat = "fedora"
        elif ids & {"opensuse", "opensuse-leap", "opensuse-tumbleweed",
                    "suse", "sles", "sled"}:
            plat = "suse"
        else:
            plat = "linux"
    _PLATFORM_CACHE.append(plat)
    return plat


def platform_managers(plat=None):
    """当前平台上适用的包管理器（flatpak 各平台都有）。"""
    plat = plat or current_platform()
    return [m for m, (p, _) in MANAGER_META.items() if p in (plat, "any")]


def visible_managers():
