def _default_dirs():
    """配置 / 缓存的默认位置。

    Windows 按惯例放 %APPDATA% / %LOCALAPPDATA%，其它系统按 XDG。
    这样 Windows 用户的配置在 %APPDATA%\\pkgtrans 下，而不是家目录里
    凭空多出一个 .config。
    """
    if os.name == "nt":
        conf = os.environ.get("APPDATA") or os.path.expanduser("~")
        cache = os.environ.get("LOCALAPPDATA") or conf
    else:
        conf = (os.environ.get("XDG_CONFIG_HOME")
                or os.path.join(os.path.expanduser("~"), ".config"))
        cache = (os.environ.get("XDG_CACHE_HOME")
                 or os.path.join(os.path.expanduser("~"), ".cache"))
    return os.path.join(conf, PROG), os.path.join(cache, PROG)


