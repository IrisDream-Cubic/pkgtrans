# 纯 ASCII 字体，用于 `pkgtrans info` 的大字图案。
#
# 刻意只用 ASCII：█ ╔ ╗ ═ 这类「方块 / 制表」字符的 East Asian Width 是
# Ambiguous，在中文环境下终端会按 2 列渲染，整个图案就会折行错位。
# ASCII 的宽度恒为 1，在任何终端、任何 markdown 渲染器里都不会错行。
BANNER_FONT = {
    "P": [" _ __ ", "| '_ \\", "| |_) |", "| .__/ ", "|_|    "],
    "K": ["| |__ ", "| / / ", "|  \\  ", "| |\\ \\", "|_| \\_\\"],
    "G": ["  __ _ ", " / _` |", "| (_| |", " \\__, |", " |___/ "],
    "T": [" _    ", "| |_  ", "|  _| ", " \\__| ", "      "],
    "R": [" _ __ ", "| '__|", "| |   ", "|_|   ", "      "],
    "A": [" __ _ ", "/ _` |", "| (_| |", " \\__,_|", "      "],
    "N": [" _ __  ", "| '_ \\ ", "| | | |", "|_| |_|", "       "],
    "S": [" ___ ", "/ __|", "\\__ \\", "|___/", "     "],
}

BANNER_HEIGHT = 5


def banner(text: str = "PKGTRANS") -> str:
    """把文字拼成 ASCII 大字图案。每行等宽，且只含 ASCII。"""
    rows = [""] * BANNER_HEIGHT
    for ch in text.upper():
        glyph = BANNER_FONT.get(ch)
        if not glyph:
            continue
        width = max(len(r) for r in glyph)
        for i in range(BANNER_HEIGHT):
            rows[i] += glyph[i].ljust(width)
    return "\n".join(r.rstrip() for r in rows)


