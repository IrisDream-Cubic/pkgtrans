WINGET_RELEASE_API = "https://api.github.com/repos/microsoft/winget-cli/releases/latest"
WINGET_ASSET_BUNDLE = "Microsoft.DesktopAppInstaller_8wekyb3d8bbwe.msixbundle"
WINGET_ASSET_DEPS = "DesktopAppInstaller_Dependencies.zip"


def _download(url, dest, label):
    """下载到 dest，只在 stderr 是终端时刷进度条（免得污染管道）。"""
    req = urllib.request.Request(url, headers={"User-Agent": f"{PROG}/{__version__}"})
    with urllib.request.urlopen(req, timeout=120) as resp, open(dest, "wb") as fh:
        total = int(resp.headers.get("Content-Length") or 0)
        got = 0
        while True:
            chunk = resp.read(1 << 20)
            if not chunk:
                break
            fh.write(chunk)
            got += len(chunk)
            if total and sys.stderr.isatty():
                eprint(f"\r  {label} {got * 100 // total}%"
                       f"  ({got // 1048576}/{total // 1048576} MiB)", end="")
    if sys.stderr.isatty():
        eprint("\r" + " " * 64 + "\r", end="")
    return dest


def _pick_winget_asset(assets, name):
    for asset in assets:
        if asset.get("name") == name:
            return asset.get("browser_download_url")
    return None


def _add_appx(path) -> bool:
    """用 PowerShell 的 Add-AppxPackage 装一个 .appx / .msixbundle。"""
    proc = subprocess.run(
        ["powershell", "-NoProfile", "-NonInteractive", "-Command",
         f"Add-AppxPackage -Path '{path}' -ErrorAction Stop"],
        stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
    )
    if proc.returncode != 0:
        fail(f"Add-AppxPackage 失败：{os.path.basename(path)}")
        text = proc.stdout.decode("utf-8", "replace").strip()
        if text:
            eprint(text[:800])
        return False
    return True


def cmd_install_winget(st: Settings, rest) -> int:
    """给没有 winget 的 Windows 机器装上 winget（App Installer）。

    走官方 release：先装依赖框架包，再装 msixbundle。Windows Server / LTSC
    上没有 Microsoft Store，只能这么装。
    """
    if os.name != "nt":
        fail(f"winget 是 Windows 的包管理器，`{PROG} install-winget` 只在 Windows 上可用")
        note(f"其它系统用本平台自己的：{', '.join(platform_managers())}")
        return 1

    found = shutil.which("winget")
    if found:
        ok(f"已经装了：{found}")
        return 0

    machine = (platform.machine() or "").lower()
    # GitHub 那边的依赖包按架构分文件，取本机这一份
    want = {"amd64": "x64", "x86": "x86", "arm64": "arm64", "arm": "arm"}.get(machine, "x64")
    eprint(f"  没找到 winget，准备安装官方 App Installer（{want} 架构）")
    note("从 microsoft/winget-cli 的最新 release 下载，约 300 MiB")

    tmp = tempfile.mkdtemp(prefix="pkgtrans-winget-")
    try:
        req = urllib.request.Request(
            WINGET_RELEASE_API,
            headers={"User-Agent": f"{PROG}/{__version__}",
                     "Accept": "application/vnd.github+json"},
        )
        with urllib.request.urlopen(req, timeout=60) as resp:
            release = json.loads(resp.read().decode("utf-8"))
        tag = release.get("tag_name") or "?"
        assets = release.get("assets") or []
        bundle_url = _pick_winget_asset(assets, WINGET_ASSET_BUNDLE)
        deps_url = _pick_winget_asset(assets, WINGET_ASSET_DEPS)
        if not bundle_url:
            fail(f"{tag} 里找不到 {WINGET_ASSET_BUNDLE}，上游可能改了资产命名")
            note(f"手动下载：https://github.com/microsoft/winget-cli/releases/tag/{tag}")
            return 1
        eprint(f"  版本：{tag}")

        packages = []
        if deps_url:
            zip_path = _download(deps_url, os.path.join(tmp, "deps.zip"), "依赖包")
            with zipfile.ZipFile(zip_path) as zf:
                for member in zf.namelist():
                    low = member.lower()
                    if not low.endswith((".appx", ".msix")):
                        continue
                    # 依赖包里各架构同名，只挑本机的
                    if want not in low:
                        continue
                    out = os.path.join(tmp, os.path.basename(member))
                    with zf.open(member) as src, open(out, "wb") as dst:
                        shutil.copyfileobj(src, dst)
                    packages.append(out)
            if not packages:
                warn(f"依赖包里没找到 {want} 架构的框架包，先只装主包试试")
        bundle_path = _download(bundle_url, os.path.join(tmp, "winget.msixbundle"),
                                "App Installer")
        packages.append(bundle_path)

        for path in packages:
            eprint(f"  安装 {os.path.basename(path)}")
            if not _add_appx(path):
                note("可以试试用管理员身份重跑，或用 Microsoft Store 装 App Installer")
                return 1
    except (urllib.error.URLError, OSError, ValueError, zipfile.BadZipFile) as exc:
        fail(f"下载 / 解包失败：{exc}")
        note("手动下载：https://github.com/microsoft/winget-cli/releases")
        return 1
    finally:
        shutil.rmtree(tmp, ignore_errors=True)

    if shutil.which("winget"):
        ok("winget 装好了")
    else:
        warn("装完了，但当前 PATH 里还看不到 winget —— 重开一个窗口再试 `winget --version`")
    note(f"接着可以跑 `{PROG} setup winget` 让 winget show 自动翻译")
    return 0


# ------------------------------------------------------------------ on/off

def cmd_onoff(st: Settings, enable: bool) -> int:
    if not update_config_value(st.config_path, "enabled", "1" if enable else "0"):
        fail(f"写入配置失败：{st.config_path}")
        return 1
    if enable:
        ok("已开启")
        if not usable_backends(st):
            warn("还没有可用的 API 密钥，跑 `pkgtrans keyadd`")
    else:
        ok("已关闭，所有命令原样透传")
    return 0


# ------------------------------------------------------------------ 分发

SUBCOMMANDS = {
    "help", "info", "version", "check", "status",
    "aim", "keylist", "keyadd", "keyremove", "keyprefer", "keylock", "keyunlock",
    "setup", "putes", "putesy", "unsetup",
    "install-winget",
    "on", "off", "clear-cache", "show-config",
    "install-shell", "uninstall-shell",
}


def dispatch_subcommand(name: str, rest):
    st = load_settings({})
    for err in st.errors:
        eprint(f"{PROG}: {err}")

    if name == "help":
        write_stdout(HELP)
        return 0
    if name in ("info", "version"):
        return cmd_info(st)
    if name in ("check", "status"):
        return do_check(st, {})
    if name == "aim":
        return cmd_aim(st, rest)
    if name == "keylist":
        return cmd_keylist(st)
    if name == "keyadd":
        return cmd_keyadd(st, rest)
    if name == "keyremove":
        return cmd_keyremove(st, rest)
    if name == "keyprefer":
        return cmd_keyprefer(st, rest)
    if name == "keylock":
        return cmd_keylock(st, True)
    if name == "keyunlock":
        return cmd_keylock(st, False)
    if name == "setup":
        return cmd_setup(st, rest)
    if name in ("putes", "putesy", "unsetup"):
        return cmd_putes(st, rest)
    if name == "install-winget":
        return cmd_install_winget(st, rest)
    if name in ("on", "off"):
        return cmd_onoff(st, name == "on")
    if name == "clear-cache":
        return do_clear_cache(st)
    if name == "show-config":
        return do_show_config(st)
    if name == "install-shell":
        shell = require_shell()
        return 1 if shell is None else (0 if install_shell(shell, shell_targets(st)) else 1)
    if name == "uninstall-shell":
        shell = require_shell()
        return 1 if shell is None else uninstall_shell(shell)
    fail(f"未知子命令 {name}")
    return 2


def main(argv):
    enable_ansi()
    # 子命令优先：`pkgtrans setup pamac` 之类不会被当成要包装的命令
    if argv and argv[0] in SUBCOMMANDS:
        return dispatch_subcommand(argv[0], argv[1:])

    try:
        cli, command, cmdargs = parse_args(argv)
    except UsageError as exc:
        fail(str(exc))
        note(f"试试 `{PROG} help`")
        return 2

    if cli.get("help"):
        write_stdout(HELP)
        return 0
    if cli.get("version"):
        return cmd_info()
    if cli.get("shell_init"):
        shell = cli["shell_init"] if isinstance(cli["shell_init"], str) else guess_shell()
        st0 = load_settings(cli)
        write_stdout(shell_snippet(shell, shell_targets(st0)))
        return 0
    if cli.get("install_shell"):
        shell = require_shell()
        if shell is None:
            return 1
        st0 = load_settings(cli)
        return 0 if install_shell(shell, shell_targets(st0)) else 1
    if cli.get("uninstall_shell"):
        shell = require_shell()
        return 1 if shell is None else uninstall_shell(shell)

    st = load_settings(cli)
    for err in st.errors:
        eprint(f"{PROG}: {err}")

    if cli.get("show_config"):
        return do_show_config(st)
    if cli.get("check"):
        return do_check(st, cli)
    if cli.get("clear_cache"):
        return do_clear_cache(st)

    disabled = (not as_bool(st["enabled"])) or cli.get("raw") \
        or bool(os.environ.get("PSTRANS_DISABLE"))

    # ---- 管道模式 ----
    if command is None:
        if sys.stdin.isatty():
            write_stdout(HELP)
            return 0
        text = read_stdin()
        if disabled:
            write_stdout(text)
            return 0
        dialect = cli.get("dialect") or detect_dialect(text)
        if dialect == "auto":
            dialect = detect_dialect(text)
        if cli.get("verbose"):
            eprint(f"{PROG}: 管道模式，识别为 {dialect} 格式")
        write_stdout(process(text, st, cli, dialect))
        return 0

    # ---- 命令模式 ----
    if disabled:
        mode, dialect = "other", "pacman"
    else:
        mode, dialect = classify(command, cmdargs)
    binary = resolve_binary(command)
    if binary is None:
        eprint(f"{PROG}: 找不到命令 {command}")
        return 127

    if mode == "other":
        # 完全透传：不捕获输出，终端/交互/退出码/信号全部保持原样
        try:
            os.execv(binary, [command] + cmdargs)
        except OSError as exc:
            eprint(f"{PROG}: 无法执行 {binary}: {exc}")
            return 126

    # 搜索/信息类：捕获输出后翻译
    try:
        proc = subprocess.run(
            [binary] + cmdargs,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=None,          # stderr 直接透传，yay/pamac 的进度提示照常显示
            check=False,
        )
    except OSError as exc:
        eprint(f"{PROG}: 无法执行 {binary}: {exc}")
        return 126
    text = proc.stdout.decode("utf-8", "replace")
    if proc.returncode != 0 and not text.strip():
        return proc.returncode
    columns = flatpak_columns(cmdargs) if dialect == "flatpak" else None
    write_stdout(process(text, st, cli, dialect, columns))
    return proc.returncode


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        eprint(f"\n{PROG}: 已中断")
        sys.exit(130)
    except BrokenPipeError:
        sys.exit(0)
