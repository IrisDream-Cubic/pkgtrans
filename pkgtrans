# 命令分类：只翻译搜索/信息类调用，其他一律透传
# --------------------------------------------------------------------------

MODE_LONG = {
    "--sync": "S", "--query": "Q", "--database": "D", "--remove": "R",
    "--upgrade": "U", "--files": "F", "--deptest": "T",
    "--search": "s", "--info": "i", "--list": "l", "--groups": "g",
    "--owns": "o", "--file": "p", "--print": "p",
}
OPS = set("SQDRUFT")


def _classify_pacman(argv):
    """pacman / yay / paru 的旗标式调用。"""
    ops = set()
    subs = set()
    for arg in argv:
        if arg == "--":
            break
        if arg.startswith("--"):
            name = arg.split("=", 1)[0]
            code = MODE_LONG.get(name)
            if code:
                (ops if code in OPS else subs).add(code)
        elif arg.startswith("-") and len(arg) > 1:
            for ch in arg[1:]:
                if ch in OPS:
                    ops.add(ch)
                elif ch in ("b", "r"):
                    break          # 该短选项带参数，后面的字符属于参数值
                else:
                    subs.add(ch)
    if not ops & {"S", "Q", "F"}:
        return "other"
    if "s" in subs:
        return "search"
    if "i" in subs:
        return "info"
    return "other"


def _first_action(argv):
    """子命令式 CLI 的第一个非选项参数（即 action）。"""
    for arg in argv:
        if arg == "--":
            continue
        if not arg.startswith("-"):
            return arg
    return ""


def flatpak_columns(argv):
    """从 `--columns=a,b,c` 里取出列顺序，用于定位 description 在第几列。"""
    for i, arg in enumerate(argv):
        if arg.startswith("--columns="):
            raw = arg.split("=", 1)[1]
        elif arg == "--columns" and i + 1 < len(argv):
            raw = argv[i + 1]
        else:
            continue
        cols = [c.strip() for c in raw.split(",") if c.strip()]
        return cols or None
    return None


def classify(command, argv):
    """返回 (mode, dialect)。

    mode:    search | info | other
    dialect: pacman | pamac | flatpak | apt | apt-cache | dnf | apt-info | dnf-info

    只在搜索/信息类调用上翻译，其余一律原样透传：

      pacman -Ss / -Qs / -Fs     -> search   (pacman)
      pacman -Si / -Qi           -> info     (pacman)
      pamac search / pamac info  -> search   (pamac，子命令语法)
      flatpak search             -> search   (flatpak，TSV 输出)
      apt search                 -> search   (输出结构与 pacman 同形)
      apt-cache search           -> search   (单行 `名字 - 描述`)
      apt show                   -> info
      dnf / yum search           -> search   (TAB 分隔的 `名字.架构`)
      dnf info                   -> info

    非搜索调用（pacman -Syu、pamac install、flatpak run、apt install、
    dnf upgrade…）一律 other，走 exec 完全透传。
    注意 -R 的 -s 是 --recursive 不是搜索，所以要求同时出现 S/Q/F。
    """
    base = os.path.basename(command or "")
    if base == "flatpak":
        if "search" != _first_action(argv):
            return "other", "flatpak"
        # --json 输出的是机器可读格式，别去动它
        if any(a in ("-j", "--json") for a in argv):
            return "other", "flatpak"
        return "search", "flatpak"
    if base in ("pamac", "pamac-cli"):
        action = _first_action(argv)
        if action in PAMAC_SUBCOMMANDS:
            return ("search" if action == "search" else "info"), "pamac"
        return "other", "pamac"
    if base in ("apt", "apt-get"):
        action = _first_action(argv)
        if action == "search":
            return "search", "apt"
        if action in ("show", "info"):
            return "info", "apt-info"
        return "other", "apt"
    if base == "apt-cache":
        action = _first_action(argv)
        if action == "search":
            return "search", "apt-cache"
        if action == "show":
            return "info", "apt-info"
        return "other", "apt-cache"
    if base in ("dnf", "yum", "microdnf"):
        action = _first_action(argv)
        if action == "search":
            return "search", "dnf"
        if action in ("info", "show"):
            return "info", "dnf-info"
        return "other", "dnf"
    if base in ("brew", "brew.rb"):
        if any(a in ("--json", "-j") for a in argv):
            return "other", "brew"          # 机器可读格式不碰
        action = _first_action(argv)
        if action == "search":
            return "search", "brew"
        if action in ("info", "desc"):
            return "info", "brew"
        return "other", "brew"
    if base in ("winget", "winget.exe"):
        action = _first_action(argv)
        # winget search 只有 Name/Id/Version/Match/Source 五列，没有描述可翻；
        # 真正带 Description 的是 winget show。
        if action in ("show", "view"):
            return "info", "info"
        return "other", "winget"
    return _classify_pacman(argv), "pacman"


def resolve_binary(name: str):
    """找到真正的可执行文件，避免踩到同名 shell 函数/包装脚本导致递归。"""
    me = os.path.realpath(sys.argv[0])
    for candidate in (f"/usr/bin/{name}", f"/bin/{name}", f"/usr/local/bin/{name}"):
        if os.path.isfile(candidate) and os.access(candidate, os.X_OK):
            return candidate
    path = shutil.which(name)
    if path and os.path.realpath(path) != me:
        return path
    return None


# --------------------------------------------------------------------------
# 主流程
# --------------------------------------------------------------------------

def collect_texts(segments, translate_info, max_items):
    """从段落里取出需要翻译的文本（保持出现顺序）。"""
    texts = []
    limit = float("inf") if max_items <= 0 else max_items
    index = 0
    for seg in segments:
        if seg.kind == KIND_OTHER:
            continue
        if index >= limit:
            index += 1
            continue
        index += 1
        if seg.kind == KIND_DESC or (seg.kind == KIND_INFO and translate_info):
            texts.append(seg.text)
    return texts, index


def process(text: str, st: Settings, opts, dialect: str = "pacman", columns=None) -> str:
    """翻译一段包管理器输出，返回最终文本。"""
    if not text.strip():
        return text

    translate_info = as_bool(st["translate_info"])
    segments = analyze(text, translate_info, dialect, columns)
    max_items = as_int(st["max_items"], 300)
    texts, total = collect_texts(segments, translate_info, max_items)

    color_enabled = want_color(st)
    if not texts:
        return render(segments, [], st, color_enabled, max_items)

    usable = usable_backends(st)
    have_api = bool(usable)

    if opts.get("verbose"):
        chain = " → ".join(b.label() for b in st.backends()) or "(未配置)"
        eprint(f"{PROG}: 后端={chain} 待译={len(texts)} 条")

    translator = Translator(st, verbose=bool(opts.get("verbose")))
    started = time.time()
    truncated = total > max_items > 0
    if have_api:
        if sys.stderr.isatty() and not opts.get("quiet"):
            hint = f"，其余 {total - max_items} 条超出上限未翻译" if truncated else ""
            eprint(f"\r{PROG}: 正在翻译 {len(texts)} 条描述…{hint}")
        results = translator.run(texts)
        if sys.stderr.isatty() and not opts.get("quiet"):
            eprint("\r" + " " * 60 + "\r", end="")
    else:
        results = [None] * len(texts)
        translator.failed = len(texts)

    rendered = render(segments, results, st, color_enabled, max_items)

    if not opts.get("quiet"):
        elapsed = time.time() - started
        bits = []
        if have_api:
            bits.append(f"{translator.translated} 条已翻译(红)")
            if translator.reused:
                bits.append(f"其中 {translator.reused} 条命中缓存")
            if translator.skipped:
                bits.append(f"{translator.skipped} 条本就中文")
        if translator.failed:
            bits.append(f"{translator.failed} 条失败(黄)")
        if truncated:
            bits.append(f"{total - max_items} 条超出上限未处理")
        if translator.switches:
            bits.append(f"切换过 {translator.switches} 次备用密钥")
        if bits:
            line = f"{PROG}: " + "，".join(bits)
            if have_api:
                line += f"，耗时 {elapsed:.1f}s"
            eprint(line)
        if not have_api:
            for line in api_setup_hints(st):
                eprint(f"{PROG}: {line}")
            eprint(f"{PROG}: 详见 `{PROG} --help`；用 `{PROG} --check` 自检。")
        if have_api and translator.failed and translator.first_error:
            eprint(f"{PROG}: 失败原因：{translator.first_error[:200]}")
    return rendered


def color_status(st: Settings):
    """返回 (是否上色, 原因)。原因用于 --check 诊断「为什么没颜色」。"""
    force = str(st["force_color"])
    if force == "1":
        return True, "--color always / force_color = 1"
    if force == "-1":
        return False, "--color never"
    if os.environ.get("NO_COLOR"):
        return False, ("环境变量 NO_COLOR 已设置 —— 红/黄标记会被完全抑制。"
                       "要恢复：unset NO_COLOR，或在配置文件里写 force_color = 1")
    if os.environ.get("CLICOLOR_FORCE") not in (None, "", "0"):
        return True, "CLICOLOR_FORCE 已设置"
    if sys.stdout.isatty():
        return True, "输出是终端"
    return False, ("输出是管道/文件（正常行为）。终端里直接运行、"
                   "或加 --color always 即可上色")


def enable_ansi() -> None:
    """Windows 10+ 的控制台默认不解析 ANSI 转义序列。

    不打开 VT 处理的话，翻译成功的红色会原样打成 `←[31m...`，
    比没颜色更难受。其它平台什么都不做。
    """
    if os.name != "nt":
        return
    try:
        import ctypes
        kernel32 = ctypes.windll.kernel32
        for handle_id in (-11, -12):          # STD_OUTPUT_HANDLE / STD_ERROR_HANDLE
            handle = kernel32.GetStdHandle(handle_id)
            mode = ctypes.c_uint32()
            if kernel32.GetConsoleMode(handle, ctypes.byref(mode)):
                kernel32.SetConsoleMode(handle, mode.value | 0x0004)
    except Exception:
        pass                                  # 重定向到文件 / 老系统：忽略


def want_color(st: Settings) -> bool:
    return color_status(st)[0]


BASE_EXAMPLES = [
    ("DeepSeek", "https://api.deepseek.com/v1"),
    ("OpenAI", "https://api.openai.com/v1"),
    ("硅基流动", "https://api.siliconflow.cn/v1"),
    ("通义千问", "https://dashscope.aliyuncs.com/compatible-mode/v1"),
    ("Anthropic", "https://api.anthropic.com"),
    ("OpenRouter", "https://openrouter.ai/api/v1"),
]


def key_shape_hint(key: str) -> str:
    """仅凭密钥格式给一条线索，不保证准确，也绝不据此自动选择服务商。"""
    k = (key or "").strip()
    if k.startswith("sk-ant-"):
        return "Anthropic"
    if k.startswith("sk-or-"):
        return "OpenRouter"
    if re.fullmatch(r"sk-[0-9a-fA-F]{32}", k):
        return "DeepSeek 或 通义千问（两家密钥格式相同，无法区分）"
    if re.fullmatch(r"sk-[A-Za-z0-9_\-]{40,}", k):
        return "OpenAI / 硅基流动 / Kimi 等"
    return ""


def api_setup_hints(st: Settings):
    """返回一组可直接照抄的配置指引。"""
    lines = []
    if st["api_key"] and not st["api_base"]:
        lines.append("已读到密钥，但光有密钥无法确定服务商，还需要一个 API 地址。")
        shape = key_shape_hint(st["api_key"])
        if shape:
            lines.append(f"（密钥格式看起来像：{shape}）")
        lines.append("补地址的方式，任选一种：")
        for name, base in BASE_EXAMPLES[:3]:
            lines.append(f"    export PSTRANS_API_BASE={base}    # {name}")
        lines.append(f"    或编辑 {st.config_path}，取消注释对应服务商那一组")
        lines.append("更省事的写法：改用带服务商名字的变量，地址会被自动识别——")
        lines.append("    unset PSTRANS_API_KEY")
        lines.append("    export DEEPSEEK_API_KEY=sk-xxxx     # 换成你实际用的那家")
        lines.append(f"最省事：跑 `{PROG} keyadd`，密钥、地址、模型一次配好并记住。")
    elif not st["api_key"]:
        lines.append("未配置 API 密钥，描述会以黄色原样显示。")
        lines.append(f"推荐：跑 `{PROG} keyadd` 交互式添加（密钥、地址、模型一次配好）。")
        lines.append("或手动用环境变量（带服务商名字的变量，地址自动识别）：")
        lines.append("    export DEEPSEEK_API_KEY=sk-xxxx     # 或 OPENAI_API_KEY / ANTHROPIC_API_KEY …")
        lines.append("通用写法（密钥和地址两个都要给）：")
        lines.append("    export PSTRANS_API_KEY=sk-xxxx")
        lines.append("    export PSTRANS_API_BASE=https://api.deepseek.com/v1")
        lines.append(f"或编辑 {st.config_path}，取消注释其中一组")
